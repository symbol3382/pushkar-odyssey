# Public values only. Copy this file to .env.local and replace the placeholders.
# Do not put a Sanity write token, management token, or other secret in any VITE_ variable.
# Those values are bundled into the public website.

# From https://www.sanity.io/manage — the project ID, not a token.
VITE_SANITY_PROJECT_ID=your_project_id

# Usually "production". Must match the dataset you publish in Studio.
VITE_SANITY_DATASET=production

# Date-based Sanity API version. 2026-02-01 is the pinned version for this app.
# Update it deliberately when you want a newer Sanity query API.
VITE_SANITY_API_VERSION=2026-02-01

# Public site origin, used for canonical URLs, Open Graph URLs, and the sitemap.
# Leave unset until the production domain is known. Do not invent a domain.
VITE_SITE_URL=https://example.com
