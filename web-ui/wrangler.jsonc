{
  // SPA fallback for client-side routes such as /tours/some-slug.
  // Do not add public/_redirects with `/* /index.html 200`. Workers
  // strips `.html` and `/index`, so that rule loops and deploy fails
  // with error 100324.
  "name": "pushkar-oddessey",
  "compatibility_date": "2026-10-18",
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
